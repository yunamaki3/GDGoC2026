{
  "name": "hachioji-gov",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "hachioji-gov: 八王子市の子育て・医療・福祉ナビ",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/capture-output.mjs logs/test-output.log npm run test:integration:raw",
    "test:integration:raw": "firebase emulators:exec --only firestore,auth --project demo-hachioji-gov \"vitest run --config vitest.integration.config.ts\"",
    "test:log-scan": "vitest run --config vitest.logscan.config.ts",
    "test:security": "npm run test:integration && npm run test:log-scan",
    "secret-scan": "gitleaks git --config .gitleaks.toml --redact --verbose .",
    "secret-scan:staged": "gitleaks git --config .gitleaks.toml --redact --staged --verbose .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "22.9.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-security": "3.0.1",
    "fast-check": "3.22.0",
    "firebase": "13.1.0",
    "firebase-tools": "13.24.1",
    "globals": "15.12.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.13.0",
    "vitest": "2.1.9"
  }
}
